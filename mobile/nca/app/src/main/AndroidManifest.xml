<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission
        android:name="android.permission.AUTHENTICATE_ACCOUNTS"
        android:maxSdkVersion="31" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
    <application
        android:name=".objects.GlobalApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nca"
        android:usesCleartextTraffic="true"
        android:extractNativeLibs="true"
        tools:targetApi="31" >
        <activity
            android:name=".households.VulnerabilityStatusActivity"
            android:exported="false"
            android:label="@string/title_activity_vulnerability_status" />
        <activity
            android:name=".households.NomineeReasonActivity"
            android:exported="false"
            android:label="@string/title_nominee_reason" />
        <activity
            android:name=".households.LiteracyActivity"
            android:exported="false"
            android:label="@string/household_literacy" />
        <activity
            android:name=".households.NomineeActivity"
            android:exported="false"
            android:label="@string/nominee" />

        <provider
            android:name=".data.BiometricsProvider"
            android:authorities="@string/content_authority"
            android:exported="false"
            android:multiprocess="true"
            android:syncable="true" />

        <service
            android:name=".sync.BiometricsAuthenticatorService"
            android:exported="true"
            android:process=":sync">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>

            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/authenticator" />
        </service>
        <service
            android:name=".sync.BiometricsSyncAdapterService"
            android:exported="true"
            android:process=":sync">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>

            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/syncadapter" />
        </service>

        <activity
            android:name=".attendance.AttendanceValidationActivity"
            android:exported="false" />
        <activity
            android:name=".attendance.AttendanceBeneficiariesActivity"
            android:exported="false" />
        <activity
            android:name=".attendance.AttendanceReaderActivity"
            android:exported="false" />
        <activity
            android:name=".reports.ReportActivity"
            android:exported="false"
            android:label="@string/title_activity_report"
            android:theme="@style/Theme.Nca.NoActionBar" />
        <activity
            android:name=".reports.UploadActivity"
            android:exported="false"
            android:label="@string/upload"
            android:theme="@style/Theme.Nca.NoActionBar" />
        <activity
            android:name=".alternates.EditAlternateActivity"
            android:exported="false"
            android:label="@string/edit_alternate" />
        <activity
            android:name=".households.EditHouseholdActivity"
            android:exported="false"
            android:label="@string/edit_households" />
        <activity
            android:name=".payments.PaymentVerificationActivity"
            android:exported="false"
            android:label="@string/payment_verification" />
        <activity
            android:name=".payments.PaymentBeneficiariesActivity"
            android:exported="false"
            android:label="@string/payment_ben_list" />
        <activity
            android:name=".payments.PaymentHouseholdsActivity"
            android:exported="false"
            android:label="@string/payment_households" />
        <activity
            android:name=".payments.PaymentPreSetupActivity"
            android:exported="false"
            android:label="@string/payment_setup" />
        <activity
            android:name=".alternates.AlternateFingerprintsActivity"
            android:exported="false"
            android:label="@string/alt_fp" />
        <activity
            android:name=".alternates.AlternatesActivity"
            android:exported="false"
            android:label="@string/alternate_reg" />
        <activity
            android:name=".alternates.AlternatesHouseholdsActivity"
            android:exported="false"
            android:label="@string/alternate_households" />
        <activity
            android:name=".households.ReviewActivity"
            android:exported="false"
            android:label="@string/complete_registration" />
        <activity
            android:name=".households.FingerprintsActivity"
            android:exported="false"
            android:label="@string/fingerprint" />
        <activity
            android:name=".households.PhotoActivity"
            android:exported="false"
            android:label="@string/capture_photo" />
        <activity
            android:name=".households.HouseholdBreakdownActivity"
            android:exported="false"
            android:label="@string/household_breakdown" />
        <activity
            android:name=".households.PersonalInfoActivity"
            android:exported="false"
            android:label="@string/personal_information" />
        <activity
            android:name=".households.LocationActivity"
            android:exported="false"
            android:label="@string/targetLocation" />
        <activity
            android:name=".home.MainActivity"
            android:exported="false"
            android:label="@string/title_activity_main"
            android:theme="@style/Theme.Nca.NoActionBar" />
        <activity
            android:name=".login.SplashActivity"
            android:exported="false"
            android:label="@string/login" />
        <activity
            android:name=".login.LoginActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Nca.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>