<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bp_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" style="@style/BioPay.Toolbar" android:title="@string/alternate_title" app:navigationIcon="@drawable/ic_arrow_back" app:navigationIconTint="@color/bp_text_primary" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="8dp" android:paddingEnd="16dp">
        <TextView android:id="@+id/tvHouseholdName" style="@style/BioPay.ScreenTitle" />
        <TextView android:id="@+id/tvHouseholdNumber" style="@style/BioPay.SupportingText" android:layout_marginTop="4dp" />
        <TextView android:id="@+id/tvListSummary" style="@style/BioPay.SupportingText" android:layout_marginTop="12dp" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerAlternates" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingStart="12dp" android:paddingTop="8dp" android:paddingEnd="12dp" android:paddingBottom="88dp" />
        <LinearLayout android:id="@+id/emptyState" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="32dp" android:visibility="gone">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@null" android:src="@drawable/ic_alternates" app:tint="@color/bp_primary" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/household_alternates_empty_title" android:textColor="@color/bp_text_primary" android:textSize="18sp" android:textStyle="bold" />
            <TextView style="@style/BioPay.SupportingText" android:layout_marginTop="6dp" android:gravity="center" android:text="@string/household_alternates_empty_body" />
        </LinearLayout>
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnAddAlternate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:contentDescription="@string/household_alternates_add"
            android:src="@drawable/ic_add"
            app:backgroundTint="@color/bp_secondary"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.BioPay.Circle"
            app:tint="@color/bp_on_primary" />
    </FrameLayout>
</LinearLayout>
