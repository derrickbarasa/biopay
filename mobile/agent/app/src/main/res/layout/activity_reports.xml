<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bp_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" style="@style/BioPay.Toolbar" android:title="@string/reports_title" app:navigationIcon="@drawable/ic_arrow_back" app:navigationIconTint="@color/bp_text_primary" />
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="8dp" android:paddingEnd="16dp" android:paddingBottom="28dp">
            <TextView style="@style/BioPay.ScreenTitle" android:text="@string/reports_title" />
            <TextView style="@style/BioPay.SupportingText" android:layout_marginTop="4dp" android:text="@string/reports_description" />

            <TextView style="@style/BioPay.SectionHeader" android:text="@string/reports_payment_totals" />
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/bp_surface" app:cardCornerRadius="@dimen/bp_radius_surface" app:cardElevation="1dp" app:strokeWidth="1dp" app:strokeColor="@color/bp_outline_variant">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:id="@+id/tvPaidAmount" style="@style/BioPay.KpiValue" android:textColor="@color/bp_success" />
                            <TextView style="@style/BioPay.KpiLabel" android:text="@string/reports_paid_amount" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:id="@+id/tvPendingAmount" style="@style/BioPay.KpiValue" android:textColor="@color/bp_warning" />
                            <TextView style="@style/BioPay.KpiLabel" android:text="@string/reports_pending_amount" />
                        </LinearLayout>
                    </LinearLayout>
                    <com.biopay.agent.home.SimpleDonutChartView android:id="@+id/chartPayments" android:layout_width="170dp" android:layout_height="170dp" android:layout_marginTop="16dp" android:layout_gravity="center_horizontal" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:id="@+id/tvPaidCount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="@color/bp_success" android:textStyle="bold" />
                        <TextView android:id="@+id/tvPendingCount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="@color/bp_warning" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView style="@style/BioPay.SectionHeader" android:text="@string/reports_data_health" />
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/bp_surface" app:cardCornerRadius="@dimen/bp_radius_surface" app:cardElevation="1dp" app:strokeWidth="1dp" app:strokeColor="@color/bp_outline_variant">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:id="@+id/tvHouseholdCount" style="@style/BioPay.KpiValue" /><TextView style="@style/BioPay.KpiLabel" android:text="@string/reports_households" /></LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:id="@+id/tvAlternateCount" style="@style/BioPay.KpiValue" /><TextView style="@style/BioPay.KpiLabel" android:text="@string/reports_alternates" /></LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:id="@+id/tvWaitingSync" style="@style/BioPay.KpiValue" android:textColor="@color/bp_warning" /><TextView style="@style/BioPay.KpiLabel" android:text="@string/reports_waiting_sync" /></LinearLayout>
                    </LinearLayout>
                    <TextView style="@style/BioPay.SupportingText" android:layout_marginTop="18dp" android:text="@string/reports_offline_note" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
