<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bp_background" android:fitsSystemWindows="true" android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" style="@style/BioPay.Toolbar" android:title="@string/reports_title"
        app:navigationIcon="@drawable/ic_arrow_back" app:navigationIconTint="@color/bp_text_primary" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingStart="16dp" android:paddingTop="8dp" android:paddingEnd="16dp" android:paddingBottom="32dp">

            <TextView style="@style/BioPay.SectionHeader" android:text="@string/reports_activity_summary" />

            <TextView android:id="@+id/tvActiveRange" style="@style/BioPay.SupportingText"
                android:layout_marginTop="0dp" android:text="@string/reports_range_scope_today" android:textSize="12sp" />

            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:clipToPadding="false" android:scrollbars="none">
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/rangeToggle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    app:checkedButton="@id/btnRangeToday" app:selectionRequired="true" app:singleSelection="true">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnRangeToday"
                        style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="44dp"
                        android:minWidth="72dp" android:text="@string/reports_range_today" android:textSize="12sp" app:cornerRadius="@dimen/bp_radius_control" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnRangeSeven"
                        style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="44dp"
                        android:minWidth="72dp" android:text="@string/reports_range_seven_days" android:textSize="12sp" app:cornerRadius="@dimen/bp_radius_control" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnRangeThirty"
                        style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="44dp"
                        android:minWidth="72dp" android:text="@string/reports_range_thirty_days" android:textSize="12sp" app:cornerRadius="@dimen/bp_radius_control" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnRangeAll"
                        style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="44dp"
                        android:minWidth="72dp" android:text="@string/reports_range_all" android:textSize="12sp" app:cornerRadius="@dimen/bp_radius_control" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </HorizontalScrollView>
            <com.google.android.material.card.MaterialCardView
                android:layout_marginTop="10dp"
                android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/bp_surface"
                app:cardCornerRadius="@dimen/bp_radius_report" app:cardElevation="0dp" app:strokeColor="@color/bp_outline_variant" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:id="@+id/tvRegistrations" style="@style/BioPay.KpiValue" />
                            <TextView style="@style/BioPay.KpiLabel" android:text="@string/reports_registrations" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:id="@+id/tvVerifications" style="@style/BioPay.KpiValue" />
                            <TextView style="@style/BioPay.KpiLabel" android:text="@string/reports_verifications" />
                        </LinearLayout>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/bp_surface_variant" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:id="@+id/tvPayments" style="@style/BioPay.KpiValue" />
                            <TextView style="@style/BioPay.KpiLabel" android:text="@string/reports_payments_completed" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:id="@+id/tvAttendance" style="@style/BioPay.KpiValue" />
                            <TextView style="@style/BioPay.KpiLabel" android:text="@string/reports_attendance_records" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView style="@style/BioPay.SectionHeader" android:text="@string/reports_payment_progress" />
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/bp_surface"
                app:cardCornerRadius="@dimen/bp_radius_report" app:cardElevation="0dp" app:strokeColor="@color/bp_outline_variant" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <com.biopay.agent.reports.PaymentStatusBarView android:id="@+id/paymentStatusBar"
                        android:layout_width="match_parent" android:layout_height="22dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                        <TextView android:id="@+id/tvPaidCount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:textColor="@color/bp_success" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tvPendingCount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:gravity="center" android:textColor="@color/bp_warning" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tvFailedCount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:gravity="end" android:textColor="@color/bp_error" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>
                    <TextView android:id="@+id/tvPaymentAmounts" style="@style/BioPay.SupportingText" android:layout_marginTop="8dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnViewPayments"
                        style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp"
                        android:layout_gravity="end" android:text="@string/reports_view_payments" android:drawableEnd="@drawable/ic_chevron_right" android:drawablePadding="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView android:id="@+id/tvActivityChartTitle" style="@style/BioPay.SectionHeader" android:text="@string/reports_seven_day_activity" />
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/bp_surface"
                app:cardCornerRadius="@dimen/bp_radius_report" app:cardElevation="0dp" app:strokeColor="@color/bp_outline_variant" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <com.biopay.agent.reports.SevenDayActivityChartView android:id="@+id/activityChart"
                        android:layout_width="match_parent" android:layout_height="150dp" />
                    <TextView style="@style/BioPay.SupportingText" android:layout_marginTop="6dp"
                        android:text="@string/reports_activity_chart_note" android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView style="@style/BioPay.SectionHeader" android:text="@string/reports_data_health" />
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/bp_surface"
                app:cardCornerRadius="@dimen/bp_radius_report" app:cardElevation="0dp" app:strokeColor="@color/bp_outline_variant" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="16dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/reports_ready_payment" android:textColor="@color/bp_text_primary" android:textSize="14sp" />
                        <TextView android:id="@+id/tvReadyHouseholds" style="@style/BioPay.SummaryValue" android:textColor="@color/bp_success" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/bp_surface_variant" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="16dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/reports_missing_biometrics" android:textColor="@color/bp_text_primary" android:textSize="14sp" />
                        <TextView android:id="@+id/tvMissingBiometrics" style="@style/BioPay.SummaryValue" android:textColor="@color/bp_warning" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/bp_surface_variant" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="16dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/reports_incomplete_records" android:textColor="@color/bp_text_primary" android:textSize="14sp" />
                        <TextView android:id="@+id/tvIncompleteRecords" style="@style/BioPay.SummaryValue" android:textColor="@color/bp_warning" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/bp_surface_variant" />
                    <LinearLayout android:id="@+id/rowWaitingSync" android:layout_width="match_parent" android:layout_height="56dp"
                        android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true"
                        android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="16dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/reports_waiting_sync" android:textColor="@color/bp_text_primary" android:textSize="14sp" />
                        <TextView android:id="@+id/tvWaitingSync" style="@style/BioPay.SummaryValue" android:textColor="@color/bp_warning" />
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="8dp" android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right" app:tint="@color/bp_text_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView style="@style/BioPay.SectionHeader" android:text="@string/reports_location_title" />
            <LinearLayout android:id="@+id/locationContainer" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_report_surface" android:orientation="vertical" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnViewLocations"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp"
                android:layout_gravity="end" android:text="@string/reports_view_locations" android:drawableEnd="@drawable/ic_chevron_right" android:drawablePadding="4dp" />

            <TextView style="@style/BioPay.SectionHeader" android:text="@string/reports_recent_activity" />
            <LinearLayout android:id="@+id/recentContainer" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_report_surface" android:orientation="vertical" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnViewActivity"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp"
                android:layout_gravity="end" android:text="@string/reports_view_activity" android:drawableEnd="@drawable/ic_chevron_right" android:drawablePadding="4dp" />

            <com.google.android.material.button.MaterialButton android:id="@+id/btnOpenSync" style="@style/BioPay.PrimaryButton"
                android:layout_marginTop="18dp" android:text="@string/reports_open_sync" app:icon="@drawable/ic_sync" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
