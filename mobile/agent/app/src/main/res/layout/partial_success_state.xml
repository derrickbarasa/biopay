<?xml version="1.0" encoding="utf-8"?>
<!-- Full-bleed teal success layout shared by Verification Success and Transaction Success.
     Host activities set tvSuccessTitle/tvSuccessSubtitle, inflate contentContainer with their
     own card, and wire btnSuccessPrimary (plus optionally btnSuccessSecondary, hidden by default). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bp_primary"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="48dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_success_badge">
                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check"
                    app:tint="@color/bp_primary" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvSuccessTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:textColor="@color/bp_on_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSuccessSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.9"
                android:gravity="center"
                android:textColor="@color/bp_on_primary"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/contentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSuccessSecondary"
            style="@style/BioPay.SecondaryButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:textColor="@color/bp_on_primary"
            android:visibility="gone"
            app:strokeColor="@color/bp_on_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSuccessPrimary"
            style="@style/BioPay.PrimaryButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            app:backgroundTint="@color/bp_on_primary"
            android:textColor="@color/bp_primary_dark" />
    </LinearLayout>
</LinearLayout>
