<?xml version="1.0" encoding="utf-8"?>
<!-- One row in the Household Profile's Members card. The whole row opens PersonDetailActivity
     (their own page: big photo, registered details, captured-finger status, and the entry point
     into capturing more); this row itself is just a quick-glance summary. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rowMemberHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:layout_width="38dp"
        android:layout_height="38dp">
        <FrameLayout
            android:id="@+id/frameMemberIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_icon_container">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_profile"
                app:tint="@color/bp_primary" />
        </FrameLayout>
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivMemberPhoto"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/BioPay.CircleImage"
            app:strokeColor="@color/bp_outline_variant"
            app:strokeWidth="1dp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tvMemberName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/bp_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvMemberRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/bp_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivMemberFingerprint"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="6dp"
        android:contentDescription="@string/settings_test_scanner"
        android:src="@drawable/ic_fingerprint" />

    <ImageView
        android:id="@+id/ivMemberFace"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="2dp"
        android:contentDescription="@string/settings_face_title"
        android:src="@drawable/ic_face" />

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/bp_text_secondary" />
</LinearLayout>
