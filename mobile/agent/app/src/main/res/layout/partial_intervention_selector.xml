<?xml version="1.0" encoding="utf-8"?>
<!-- Cash / Voucher / Food / In-kind segmented picker. Selection state (background, tint, text
     color per item) is driven entirely by the host activity (see DisbursementActivity's
     intervention-type handling); this layout only lays the four options out. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/btnInterventionCash"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_status_neutral"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">
        <ImageView android:id="@+id/ivInterventionCash" android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="@null" android:src="@drawable/ic_payments" app:tint="@color/bp_text_secondary" />
        <TextView android:id="@+id/tvInterventionCash" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/intervention_cash" android:textColor="@color/bp_text_secondary" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnInterventionVoucher"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_status_neutral"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">
        <ImageView android:id="@+id/ivInterventionVoucher" android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="@null" android:src="@drawable/ic_voucher" app:tint="@color/bp_text_secondary" />
        <TextView android:id="@+id/tvInterventionVoucher" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/intervention_voucher" android:textColor="@color/bp_text_secondary" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnInterventionFood"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_status_neutral"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">
        <ImageView android:id="@+id/ivInterventionFood" android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="@null" android:src="@drawable/ic_alternates" app:tint="@color/bp_text_secondary" />
        <TextView android:id="@+id/tvInterventionFood" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/intervention_food" android:textColor="@color/bp_text_secondary" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnInterventionInKind"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_status_neutral"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">
        <ImageView android:id="@+id/ivInterventionInKind" android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="@null" android:src="@drawable/ic_households" app:tint="@color/bp_text_secondary" />
        <TextView android:id="@+id/tvInterventionInKind" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/intervention_in_kind" android:textColor="@color/bp_text_secondary" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
