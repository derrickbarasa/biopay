<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bp_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/BioPay.Toolbar"
        app:menu="@menu/household_detail"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/bp_text_primary" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <!-- Hero header -->
            <LinearLayout style="@style/BioPay.HeroHeader">
                <TextView
                    android:id="@+id/tvHeroName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/bp_on_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvHeroCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.84"
                    android:textColor="@color/bp_on_primary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tvHeroEligible"
                        style="@style/BioPay.StatusChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_status_success"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="4dp"
                        android:textColor="@color/bp_success"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvHeroMemberCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:textColor="@color/bp_on_primary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Household info -->
            <TextView style="@style/BioPay.SectionHeader" android:text="@string/household_detail_household_card" />
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/bp_surface"
                app:cardCornerRadius="@dimen/bp_radius_surface"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/bp_outline_variant">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView style="@style/BioPay.SummaryLabel" android:text="@string/household_detail_head_role" />
                        <TextView android:id="@+id/tvHeadName" style="@style/BioPay.SummaryValue" />
                    </LinearLayout>
                    <View style="@style/BioPay.RowDivider" android:layout_marginTop="10dp" android:layout_marginBottom="10dp" android:layout_marginStart="0dp" android:layout_marginEnd="0dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView style="@style/BioPay.SummaryLabel" android:text="@string/household_detail_state" />
                        <TextView android:id="@+id/tvState" style="@style/BioPay.SummaryValue" />
                    </LinearLayout>
                    <View style="@style/BioPay.RowDivider" android:layout_marginTop="10dp" android:layout_marginBottom="10dp" android:layout_marginStart="0dp" android:layout_marginEnd="0dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView style="@style/BioPay.SummaryLabel" android:text="@string/household_detail_county" />
                        <TextView android:id="@+id/tvCounty" style="@style/BioPay.SummaryValue" />
                    </LinearLayout>
                    <View style="@style/BioPay.RowDivider" android:layout_marginTop="10dp" android:layout_marginBottom="10dp" android:layout_marginStart="0dp" android:layout_marginEnd="0dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView style="@style/BioPay.SummaryLabel" android:text="@string/household_detail_location" />
                        <TextView android:id="@+id/tvLocation" style="@style/BioPay.SummaryValue" />
                    </LinearLayout>
                    <View style="@style/BioPay.RowDivider" android:layout_marginTop="10dp" android:layout_marginBottom="10dp" android:layout_marginStart="0dp" android:layout_marginEnd="0dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView style="@style/BioPay.SummaryLabel" android:text="@string/household_detail_village" />
                        <TextView android:id="@+id/tvVillage" style="@style/BioPay.SummaryValue" />
                    </LinearLayout>
                    <View style="@style/BioPay.RowDivider" android:layout_marginTop="10dp" android:layout_marginBottom="10dp" android:layout_marginStart="0dp" android:layout_marginEnd="0dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView style="@style/BioPay.SummaryLabel" android:text="@string/household_detail_registration_method" />
                        <TextView android:id="@+id/tvRegistrationMethod" style="@style/BioPay.SummaryValue" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Members -->
            <TextView style="@style/BioPay.SectionHeader" android:id="@+id/tvMembersHeader" />
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/bp_surface"
                app:cardCornerRadius="@dimen/bp_radius_surface"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/bp_outline_variant">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <LinearLayout
                        android:id="@+id/containerMembers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Entitlement / status -->
            <TextView style="@style/BioPay.SectionHeader" android:text="@string/household_detail_entitlement" />
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEntitlement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/bp_radius_surface"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/bp_outline_variant">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/tvEntitlementStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCapture"
                    style="@style/BioPay.PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/household_detail_capture"
                    app:backgroundTint="@color/bp_primary"
                    app:icon="@drawable/ic_fingerprint" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddAlternate"
                    style="@style/BioPay.SecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/household_detail_add_alternate"
                    app:icon="@drawable/ic_add" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
