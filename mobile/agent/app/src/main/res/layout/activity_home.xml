<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bp_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/bp_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOrgLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/bp_text_secondary"
            android:layout_marginBottom="12dp" />

        <!-- KPI cards -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2">

            <TextView android:id="@+id/tvKpiHouseholds" style="@style/BioPay.KpiCard" android:layout_columnWeight="1" />
            <TextView android:id="@+id/tvKpiPendingSync" style="@style/BioPay.KpiCard" android:layout_columnWeight="1" />
            <TextView android:id="@+id/tvKpiPaid" style="@style/BioPay.KpiCard" android:layout_columnWeight="1" />
            <TextView android:id="@+id/tvKpiPending" style="@style/BioPay.KpiCard" android:layout_columnWeight="1" />
        </GridLayout>

        <!-- Dashboard chart -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_chart_title"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <com.biopay.agent.home.SimpleBarChartView
                    android:id="@+id/chartPayments"
                    android:layout_width="match_parent"
                    android:layout_height="180dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Menu grid -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:columnCount="3">

            <Button android:id="@+id/btnHouseholds" style="@style/BioPay.MenuButton" android:text="@string/menu_households" android:layout_columnWeight="1" />
            <Button android:id="@+id/btnAlternates" style="@style/BioPay.MenuButton" android:text="@string/menu_alternates" android:layout_columnWeight="1" />
            <Button android:id="@+id/btnPayments" style="@style/BioPay.MenuButton" android:text="@string/menu_payments" android:layout_columnWeight="1" />
            <Button android:id="@+id/btnAttendance" style="@style/BioPay.MenuButton" android:text="@string/menu_attendance" android:layout_columnWeight="1" />
            <Button android:id="@+id/btnReports" style="@style/BioPay.MenuButton" android:text="@string/menu_reports" android:layout_columnWeight="1" />
            <Button android:id="@+id/btnLogout" style="@style/BioPay.MenuButton" android:text="@string/menu_logout" android:layout_columnWeight="1" />
        </GridLayout>

    </LinearLayout>
</ScrollView>
