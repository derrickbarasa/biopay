<?xml version="1.0" encoding="utf-8"?>
<!-- Shared bottom navigation chrome: the 5 top-level destinations (Home/Households/Payment/
     Activity/More). Included at the bottom of every top-level tab screen. Payment previously
     had an elevated, overlapping FAB shortcut straight into the pay flow, but its tap target
     covered the plain Payment item underneath, so a normal tap on "Payment" landed on the pay
     flow instead of the payments list it's supposed to open first; removed in favor of the
     single ordinary nav item below. -->
<com.google.android.material.bottomnavigation.BottomNavigationView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomNavigation"
    android:layout_width="match_parent"
    android:layout_height="@dimen/main_navigation_height"
    android:background="@color/bp_surface"
    android:minHeight="@dimen/main_navigation_height"
    app:itemActiveIndicatorStyle="@style/BioPay.NavigationActiveIndicator"
    app:itemHorizontalTranslationEnabled="false"
    app:itemIconSize="22dp"
    app:itemIconTint="@color/navigation_item_color"
    app:itemPaddingBottom="4dp"
    app:itemPaddingTop="4dp"
    app:itemTextAppearanceActive="@style/BioPay.NavigationLabel.Active"
    app:itemTextAppearanceInactive="@style/BioPay.NavigationLabel"
    app:itemTextColor="@color/navigation_item_color"
    app:labelVisibilityMode="labeled"
    app:menu="@menu/main_navigation" />
