<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bp_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/BioPay.Toolbar"
        android:title="@string/face_capture_title"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/bp_text_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/tvFaceGuidance"
            style="@style/BioPay.SupportingText"
            android:layout_marginBottom="10dp"
            android:text="@string/face_capture_guidance" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@android:color/black"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.camera.view.PreviewView
                    android:id="@+id/previewView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/tvFaceStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_status_warning"
                    android:paddingStart="14dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="8dp"
                    android:text="@string/face_capture_status_searching"
                    android:textColor="@color/bp_warning"
                    android:textStyle="bold" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCapture"
            style="@style/BioPay.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_marginTop="16dp"
            android:enabled="false"
            android:text="@string/face_capture_action"
            app:icon="@drawable/ic_face" />

        <TextView
            android:id="@+id/tvFaceResult"
            style="@style/BioPay.SupportingText"
            android:layout_marginTop="12dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
