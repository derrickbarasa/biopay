<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"
    android:minHeight="64dp" android:orientation="horizontal" android:paddingStart="16dp" android:paddingTop="10dp"
    android:paddingEnd="16dp" android:paddingBottom="10dp">
    <ImageView android:id="@+id/ivRecentIcon" android:layout_width="20dp" android:layout_height="20dp"
        android:contentDescription="@null" android:src="@drawable/ic_activity" android:tint="@color/bp_primary" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tvRecentTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/bp_text_primary" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvRecentSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/bp_text_secondary" android:textSize="12sp" />
    </LinearLayout>
    <TextView android:id="@+id/tvRecentTime" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="10dp" android:textColor="@color/bp_text_secondary" android:textSize="11sp" />
</LinearLayout>
