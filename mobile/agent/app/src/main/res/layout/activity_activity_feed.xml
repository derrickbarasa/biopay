<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bp_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/BioPay.Toolbar"
        android:title="@string/activity_feed_title"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/bp_text_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="@dimen/activity_feed_top_padding"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">
        <TextView android:id="@+id/tvScreenTitle" style="@style/BioPay.ScreenTitle" android:text="@string/activity_feed_title" />
        <TextView android:id="@+id/tvScreenDescription" style="@style/BioPay.SupportingText" android:layout_marginTop="4dp" android:text="@string/activity_feed_description" />

        <androidx.appcompat.widget.SearchView
            android:id="@+id/searchView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/list_search_height"
            android:layout_marginTop="@dimen/list_search_margin_top"
            android:background="@drawable/bg_icon_container"
            android:iconifiedByDefault="false"
            android:queryHint="@string/activity_feed_search_hint" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupActivityFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipActivityAll"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/activity_feed_filter_all" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipActivityRegistrations"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/activity_feed_filter_registrations" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipActivityVerification"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/activity_feed_filter_verification" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipActivityDisbursements"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/activity_feed_filter_disbursements" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerActivity"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingTop="4dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp" />

        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_activity"
                app:tint="@color/bp_primary" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/activity_feed_empty_title"
                android:textColor="@color/bp_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                style="@style/BioPay.SupportingText"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/activity_feed_empty_body" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
