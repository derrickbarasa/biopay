<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bp_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/BioPay.Toolbar"
        android:title="@string/person_capture_title"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/bp_text_primary" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvPersonName"
                style="@style/BioPay.ScreenTitle" />
            <TextView
                android:id="@+id/tvPersonSubtitle"
                style="@style/BioPay.SupportingText"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/rowFingerprint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/bp_surface"
                app:cardCornerRadius="@dimen/bp_radius_surface"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/bp_outline_variant">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        style="@style/BioPay.SectionHeader"
                        android:layout_marginTop="0dp"
                        android:drawableStart="@drawable/ic_fingerprint"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:text="@string/person_capture_fingerprint_label" />
                    <TextView
                        style="@style/BioPay.SupportingText"
                        android:text="@string/person_capture_fingerprint_hint" />
                    <TextView
                        android:id="@+id/tvFingerprintRowStatus"
                        style="@style/BioPay.SupportingText"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/bp_primary"
                        android:textStyle="bold"
                        android:text="@string/person_capture_not_captured" />

                    <include layout="@layout/layout_finger_hand_grid" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/rowPhoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/bp_surface"
                app:cardCornerRadius="@dimen/bp_radius_surface"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/bp_outline_variant">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivPersonPhoto"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_marginEnd="14dp"
                        android:foreground="?attr/selectableItemBackground"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_profile"
                        app:shapeAppearanceOverlay="@style/BioPay.CircleImage"
                        app:strokeColor="@color/bp_outline_variant"
                        app:strokeWidth="1dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/BioPay.SectionHeader"
                            android:layout_marginTop="0dp"
                            android:text="@string/person_capture_photo_label" />
                        <TextView
                            style="@style/BioPay.SupportingText"
                            android:text="@string/person_capture_photo_hint" />
                        <TextView
                            android:id="@+id/tvPhotoRowStatus"
                            style="@style/BioPay.SupportingText"
                            android:text="@string/person_capture_not_captured" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCapturePhoto"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/person_capture_photo_action" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/rowFace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/bp_surface"
                app:cardCornerRadius="@dimen/bp_radius_surface"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/bp_outline_variant">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        style="@style/BioPay.SectionHeader"
                        android:layout_marginTop="0dp"
                        android:drawableStart="@drawable/ic_face"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:text="@string/person_capture_face_label" />
                    <TextView
                        style="@style/BioPay.SupportingText"
                        android:text="@string/face_accuracy_notice"
                        android:textColor="@color/bp_warning" />
                    <TextView
                        android:id="@+id/tvFaceRowStatus"
                        style="@style/BioPay.SupportingText"
                        android:text="@string/person_capture_not_captured" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCaptureFace"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/person_capture_face_action" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/BioPay.SupportingText"
                android:layout_marginTop="8dp"
                android:text="@string/person_capture_later_note" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFinishLater"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/person_capture_finish_later" />

            <LinearLayout
                android:id="@+id/doneSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvDoneMessage"
                    style="@style/BioPay.SectionHeader"
                    android:layout_marginTop="0dp"
                    android:textColor="@color/bp_success" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddPerson"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/person_capture_add_another" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFinish"
                    style="@style/BioPay.PrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_marginTop="8dp"
                    android:text="@string/person_capture_finish" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
