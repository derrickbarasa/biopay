<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/bp_surface"
    app:cardCornerRadius="@dimen/bp_radius_surface"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/bp_outline_variant">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_icon_container" android:contentDescription="@null" android:padding="10dp" android:src="@drawable/ic_alternates" app:tint="@color/bp_primary" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tvName" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="@color/bp_text_primary" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvHousehold" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/bp_primary" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/bp_text_secondary" android:textSize="13sp" />
        </LinearLayout>
        <ImageView android:id="@+id/btnEditAlternate" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="4dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/alternate_edit_action" android:padding="9dp" android:src="@drawable/ic_edit" app:tint="@color/bp_primary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
