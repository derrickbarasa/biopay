<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bp_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" style="@style/BioPay.Toolbar" android:title="@string/payment_title" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="8dp" android:paddingEnd="16dp">
        <TextView style="@style/BioPay.ScreenTitle" android:text="@string/payment_title" />
        <TextView style="@style/BioPay.SupportingText" android:layout_marginTop="4dp" android:text="@string/payment_description" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPay"
            style="@style/BioPay.PrimaryButton"
            android:layout_marginTop="16dp"
            android:text="@string/payment_pay_action"
            app:icon="@drawable/ic_payments" />
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/paymentFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:checkedButton="@id/filterAll"
            app:selectionRequired="true"
            app:singleSelection="true">
            <com.google.android.material.button.MaterialButton android:id="@+id/filterAll" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/payment_filter_all" />
            <com.google.android.material.button.MaterialButton android:id="@+id/filterPaid" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/payment_filter_paid" />
            <com.google.android.material.button.MaterialButton android:id="@+id/filterPending" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/payment_filter_pending" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
        <TextView android:id="@+id/tvListSummary" style="@style/BioPay.SupportingText" android:layout_marginTop="12dp" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerPayments" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingStart="12dp" android:paddingTop="8dp" android:paddingEnd="12dp" android:paddingBottom="20dp" />
        <LinearLayout android:id="@+id/emptyState" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="32dp" android:visibility="gone">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@null" android:src="@drawable/ic_payments" app:tint="@color/bp_primary" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/payment_empty_title" android:textColor="@color/bp_text_primary" android:textSize="18sp" android:textStyle="bold" />
            <TextView style="@style/BioPay.SupportingText" android:layout_marginTop="6dp" android:gravity="center" android:text="@string/payment_empty_body" />
        </LinearLayout>
    </FrameLayout>

    <include layout="@layout/partial_bottom_nav_bar" />
</LinearLayout>
