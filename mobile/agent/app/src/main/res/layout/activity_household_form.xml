<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bp_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/BioPay.Toolbar"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/bp_text_primary" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvFormTitle"
                style="@style/BioPay.ScreenTitle" />
            <TextView
                style="@style/BioPay.SupportingText"
                android:layout_marginTop="4dp"
                android:text="@string/household_form_offline_note" />

            <TextView style="@style/BioPay.SectionHeader" android:text="@string/section_personal_info" />

            <com.google.android.material.textfield.TextInputLayout style="@style/BioPay.FormField" android:hint="@string/field_household_name">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etHouseholdName" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" android:imeOptions="actionNext" android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout style="@style/BioPay.FormField" android:hint="@string/field_id_number">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etIdNumber" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:imeOptions="actionNext" android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout style="@style/BioPay.FormField" android:hint="@string/field_phone_number">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPhoneNumber" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="phone" android:imeOptions="actionNext" android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout style="@style/BioPay.FormField" android:hint="@string/field_age">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etAge" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:imeOptions="actionNext" android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/BioPay.DropdownField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/field_gender">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/spinnerGender" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView style="@style/BioPay.SectionHeader" android:text="@string/section_location" />
            <TextView style="@style/BioPay.SupportingText" android:text="@string/location_picker_note" />

            <LinearLayout
                android:id="@+id/locationPickerGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/BioPay.DropdownField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="@string/field_state">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/spinnerState" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/BioPay.DropdownField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="@string/field_county">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/spinnerCounty" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/BioPay.DropdownField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="@string/field_location">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/spinnerLocation" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/BioPay.DropdownField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:hint="@string/field_village">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/spinnerVillage" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/locationManualGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout style="@style/BioPay.FormField" android:hint="@string/field_state_name">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etStateName" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" android:imeOptions="actionNext" android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/BioPay.FormField" android:hint="@string/field_county_name">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etCountyName" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" android:imeOptions="actionNext" android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/BioPay.FormField" android:hint="@string/field_location_name">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPayamName" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" android:imeOptions="actionNext" android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/BioPay.FormField" android:hint="@string/field_village_name">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etBomaName" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" android:imeOptions="actionNext" android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvToggleManualEntry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:text="@string/location_enter_manually"
                android:textColor="@color/bp_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView style="@style/BioPay.SectionHeader" android:text="@string/section_household_breakdown" />
            <com.google.android.material.textfield.TextInputLayout style="@style/BioPay.FormField" android:hint="@string/field_household_size">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etHouseholdSize" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:imeOptions="actionNext" android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/BioPay.FormField" android:hint="@string/field_male_dependants">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etMaleDependants" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:imeOptions="actionNext" android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/BioPay.FormField" android:hint="@string/field_female_dependants">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etFemaleDependants" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:imeOptions="actionDone" android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView style="@style/BioPay.SectionHeader" android:text="@string/section_vulnerability_literacy" />
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/bp_surface"
                app:cardCornerRadius="@dimen/bp_radius_surface"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/bp_outline_variant">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cbDisabledMembers" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/field_has_disabled_members" />
                    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cbElderlyHeaded" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/field_elderly_headed" />
                    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cbChildHeaded" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/field_child_headed" />
                    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cbChronicIllness" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/field_chronic_illness" />
                    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cbPregnantLactating" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/field_pregnant_lactating" />
                    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cbSingleCaregiver" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/field_single_caregiver" />
                    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cbLiteracy" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/field_literate" />
                    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cbEligible" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:checked="true" android:text="@string/field_eligible" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/BioPay.DropdownField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/field_legal_status">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/spinnerLegalStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Editing an existing household: shows who's captured so far and lets the officer
                 capture the head (if still missing) or add/capture more people. Hidden while
                 creating a new household, since PersonCaptureActivity handles that flow instead. -->
            <LinearLayout
                android:id="@+id/capturedPeopleSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView style="@style/BioPay.SectionHeader" android:text="@string/household_captured_people_title" />
                <LinearLayout
                    android:id="@+id/capturedPeopleList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddPersonFromEdit"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/person_capture_add_another" />
            </LinearLayout>

            <TextView style="@style/BioPay.SectionHeader" android:text="@string/section_biometric_registration" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/BioPay.DropdownField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:hint="@string/field_registration_method">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/spinnerRegistrationMethod" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView style="@style/BioPay.SupportingText" android:text="@string/biometric_registration_note" />
            <TextView
                android:id="@+id/tvFaceAccuracyNotice"
                style="@style/BioPay.SupportingText"
                android:layout_marginTop="4dp"
                android:text="@string/face_accuracy_notice"
                android:textColor="@color/bp_warning"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSave"
        style="@style/BioPay.PrimaryButton"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="@string/household_save_continue" />
</LinearLayout>
