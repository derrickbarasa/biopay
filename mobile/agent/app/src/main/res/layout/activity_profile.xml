<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bp_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" style="@style/BioPay.Toolbar" android:title="@string/profile_title" app:navigationIcon="@drawable/ic_arrow_back" app:navigationIconTint="@color/bp_text_primary" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <TextView style="@style/BioPay.ScreenTitle" android:text="@string/profile_title" />
            <TextView style="@style/BioPay.SupportingText" android:layout_marginTop="4dp" android:text="@string/profile_description" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_brand_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">
                <TextView
                    android:id="@+id/tvProfileInitials"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_status_success"
                    android:gravity="center"
                    android:textColor="@color/bp_primary_dark"
                    android:textSize="21sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:id="@+id/tvProfileName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/bp_on_primary" android:textSize="20sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvProfileOrganisation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/bp_on_primary" android:textSize="13sp" />
                    <TextView android:id="@+id/tvProfileEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:alpha="0.84" android:textColor="@color/bp_on_primary" android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/BioPay.SectionHeader" android:text="@string/profile_account_details" />
            <com.google.android.material.textfield.TextInputLayout style="@style/BioPay.FormField" android:hint="@string/profile_first_name">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etFirstName" android:layout_width="match_parent" android:layout_height="wrap_content" android:autofillHints="givenName" android:inputType="textCapWords" android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/BioPay.FormField" android:hint="@string/profile_last_name">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etLastName" android:layout_width="match_parent" android:layout_height="wrap_content" android:autofillHints="familyName" android:inputType="textCapWords" android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView style="@style/BioPay.SupportingText" android:layout_marginTop="4dp" android:text="@string/profile_email_note" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveProfile" style="@style/BioPay.PrimaryButton" android:layout_marginTop="20dp" android:text="@string/profile_save" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
