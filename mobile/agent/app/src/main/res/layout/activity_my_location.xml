<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bp_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" style="@style/BioPay.Toolbar" android:title="@string/home_quick_my_location" app:navigationIcon="@drawable/ic_arrow_back" app:navigationIconTint="@color/bp_text_primary" />
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="8dp" android:paddingEnd="16dp" android:paddingBottom="28dp">
            <TextView style="@style/BioPay.SupportingText" android:layout_marginTop="4dp" android:text="@string/my_location_description" />

            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardBackgroundColor="@color/bp_surface" app:cardCornerRadius="16dp" app:cardElevation="1dp" app:strokeWidth="1dp" app:strokeColor="@color/bp_outline_variant">
                <com.biopay.agent.location.SiteMapView android:id="@+id/siteMapView" android:layout_width="match_parent" android:layout_height="260dp" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardBackgroundColor="@color/bp_surface" app:cardCornerRadius="16dp" app:cardElevation="1dp" app:strokeWidth="1dp" app:strokeColor="@color/bp_outline_variant">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView android:id="@+id/tvCoordinates" style="@style/BioPay.KpiValue" android:textSize="18sp" />
                    <TextView android:id="@+id/tvAccuracy" style="@style/BioPay.KpiLabel" android:layout_marginTop="4dp" />
                    <TextView android:id="@+id/tvTimestamp" style="@style/BioPay.KpiLabel" android:layout_marginTop="2dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton android:id="@+id/btnRefreshLocation" style="@style/BioPay.SecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/my_location_refresh" app:icon="@drawable/ic_sync" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
