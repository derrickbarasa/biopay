<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Explicit parent="" on every dotted BioPay.* style below: AAPT otherwise treats the
         segment before the first dot as an implicit parent style name and fails to resolve a
         (nonexistent) plain "BioPay" style. -->
    <style name="BioPay.KpiCard" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">@color/bp_surface</item>
        <item name="android:textColor">@color/bp_text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="BioPay.MenuButton" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:backgroundTint">@color/bp_primary</item>
        <item name="android:textColor">@color/bp_on_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="BioPay.FormField" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@color/bp_surface</item>
        <item name="android:textColor">@color/bp_text_primary</item>
        <item name="android:textColorHint">@color/bp_text_secondary</item>
    </style>

    <style name="BioPay.SectionHeader" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/bp_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
