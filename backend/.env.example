# ---------------------------------------------------------------------------
# BioPay backend configuration (loaded by dotenv-java at startup).
# Copy to .env and fill in real values -- .env is gitignored, this file isn't.
# ---------------------------------------------------------------------------

# ---- HTTP server ------------------------------------------------------------
SYSTEM_HOST=0.0.0.0
SYSTEM_PORT=7730

# Mobile API endpoints. Change BIOPAY_MOBILE_API_BASE_URL to select the build default.
# Android Emulator reaches this computer through 10.0.2.2; localhost is for this computer itself.
BIOPAY_ANDROID_EMULATOR_BASE_URL=http://10.0.2.2:7730/biopay
BIOPAY_LOCALHOST_BASE_URL=http://127.0.0.1:7730/biopay
BIOPAY_MOBILE_API_BASE_URL=http://10.0.2.2:7730/biopay
# Require a fresh online login and anchor subscription check after this many days.
BIOPAY_OFFLINE_ACCESS_DAYS=60
# Days added when a subscription is created or renewed.
SUBSCRIPTION_PERIOD_DAYS=60

# ---- Database (MSSQL) -- REQUIRED, fill these in ----------------------------
DATABASE_IP=localhost
DATABASE_PORT=1433
DATABASE_NAME=biopay
DATABASE_USERNAME=sa
DATABASE_PASSWORD=replace-me

# ---- JWT (RS256) --------------------------------------------------------------
# The app signs access tokens with RS256 and needs a JKS keystore containing an
# RSA keypair under the alias "RS256". Generate biopay.jks in the backend/ folder
# with the keytool command from the run guide, using this same password.
JWT_KEYSTORE_PATH=biopay.jks
JWT_KEYSTORE_PASSWORD=replace-me
JWT_ACCESS_TOKEN_MINUTES=15

# ---- Fingerprint template at-rest encryption (AES-256-GCM) -------------------
# Base64 of 32 random bytes. KEEP THIS STABLE once you have enrolled
# fingerprints -- changing it makes existing templates undecryptable.
FINGERPRINT_ENCRYPTION_KEY=replace-with-base64-32-random-bytes
# Keep false in production. Matching is performed by the licensed IDEMIA SDK on
# device; this only exists as a placeholder/test path, never a real matcher.
ALLOW_LEGACY_FINGERPRINT_MATCH=false

# ---- Misc ---------------------------------------------------------------------
# Used to build password-reset / verification links in emails.
FRONTEND_BASE_URL=http://127.0.0.1:5175
# Single-use email approval links expire after this many hours (1-168).
APPROVAL_LINK_TTL_HOURS=24
# Authenticator-app issuer label shown when enrolling TOTP.
TOTP_ISSUER=BioPay
# Local storage for uploaded beneficiary images and app logs (auto-created).
UPLOADS_PATH=uploads
LOGS_PATH=logs
# Max upload size in bytes (5 MB default).
MAX_UPLOAD_BYTES=5242880

# ---- Login OTP ------------------------------------------------------------
# Development/test switch. Only the explicit value false bypasses OTP -- any
# missing or unrecognised value keeps the OTP challenge enabled (fail-safe).
OTP_REQUIRED=true

# ---- Transactional email (ZeptoMail) -- never commit a real token -----------
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_API_TOKEN=replace-with-rotated-send-mail-token
ZEPTO_MAIL_FROM=noreply@example.org
MAIL_FROM_NAME=BioPay

# ---- Chat assistant (self-hosted Ollama) -------------------------------------
# Plain http is only ever safe on localhost/a private network -- dashboard-mode
# prompts carry a tenant's live counts. Never point this at a public IP over
# plain http; put it behind TLS + auth first if it's ever off-box.
LLM_URL=http://localhost:11434
LLM_ALLOW_INSECURE_TRANSPORT=true
LLM_MODEL=qwen2.5:7b
# Generic fallback timeout for any non-chat LLM caller. Chat itself uses the
# much shorter CHAT_LLM_TIMEOUT_MS below so a slow reply can't outlive the
# HTTP request that's waiting on it.
LLM_TIMEOUT_MS=600000
CHAT_LLM_TIMEOUT_MS=60000
# Caps worst-case generation length/time for a conversational reply.
CHAT_LLM_NUM_PREDICT=400
# JVM-wide concurrency gate shared by every OllamaClient instance/caller --
# a single self-hosted model instance serialises inference anyway, so this
# just queues extra callers instead of thrashing it.
LLM_MAX_CONCURRENT_REQUESTS=1
# How long Ollama keeps the model loaded in memory after the last request --
# a reload after this expires costs several seconds on the next reply.
LLM_KEEP_ALIVE=30m
