# Runtime
SYSTEM_HOST=0.0.0.0
SYSTEM_PORT=7730
FRONTEND_BASE_URL=http://localhost:5173

# Microsoft SQL Server
DATABASE_IP=localhost
DATABASE_PORT=1433
DATABASE_NAME=biopay
DATABASE_USERNAME=sa
DATABASE_PASSWORD=replace-me

# ZeptoMail transactional email. Never commit a real token.
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_API_TOKEN=replace-with-rotated-send-mail-token
ZEPTO_MAIL_FROM=noreply@example.org
MAIL_FROM_NAME=BioPay

# Keep false in production. Matching is performed by the licensed IDEMIA SDK on device.
ALLOW_LEGACY_FINGERPRINT_MATCH=false
