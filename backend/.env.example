# ---------------------------------------------------------------------------
# BioPay backend configuration (loaded by dotenv-java at startup).
# Copy to .env and fill in real values -- .env is gitignored, this file isn't.
# ---------------------------------------------------------------------------

# ---- HTTP server ------------------------------------------------------------
SYSTEM_HOST=0.0.0.0
SYSTEM_PORT=7730

# ---- Database (MSSQL) -- REQUIRED, fill these in ----------------------------
DATABASE_IP=localhost
DATABASE_PORT=1433
DATABASE_NAME=biopay
DATABASE_USERNAME=sa
DATABASE_PASSWORD=replace-me

# ---- JWT (RS256) --------------------------------------------------------------
# The app signs access tokens with RS256 and needs a JKS keystore containing an
# RSA keypair under the alias "RS256". Generate biopay.jks in the backend/ folder
# with the keytool command from the run guide, using this same password.
JWT_KEYSTORE_PATH=biopay.jks
JWT_KEYSTORE_PASSWORD=replace-me
JWT_ACCESS_TOKEN_MINUTES=15

# ---- Fingerprint template at-rest encryption (AES-256-GCM) -------------------
# Base64 of 32 random bytes. KEEP THIS STABLE once you have enrolled
# fingerprints -- changing it makes existing templates undecryptable.
FINGERPRINT_ENCRYPTION_KEY=replace-with-base64-32-random-bytes
# Keep false in production. Matching is performed by the licensed IDEMIA SDK on
# device; this only exists as a placeholder/test path, never a real matcher.
ALLOW_LEGACY_FINGERPRINT_MATCH=false

# ---- Misc ---------------------------------------------------------------------
# Used to build password-reset / verification links in emails.
FRONTEND_BASE_URL=http://localhost:5173
# Authenticator-app issuer label shown when enrolling TOTP.
TOTP_ISSUER=BioPay
# Local storage for uploaded beneficiary images and app logs (auto-created).
UPLOADS_PATH=uploads
LOGS_PATH=logs
# Max upload size in bytes (5 MB default).
MAX_UPLOAD_BYTES=5242880

# ---- Login OTP ------------------------------------------------------------
# Development/test switch. Only the explicit value false bypasses OTP -- any
# missing or unrecognised value keeps the OTP challenge enabled (fail-safe).
OTP_REQUIRED=true

# ---- Transactional email (ZeptoMail) -- never commit a real token -----------
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_API_TOKEN=replace-with-rotated-send-mail-token
ZEPTO_MAIL_FROM=noreply@example.org
MAIL_FROM_NAME=BioPay
