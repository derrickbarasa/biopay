# Copy to .env and fill in real values -- .env is gitignored, this file isn't.

# The backend's dispatch base URL (see backend/.env's SYSTEM_HOST/SYSTEM_PORT).
VITE_API_BASE_URL=http://localhost:7730/biopay

# Shown in the website footer's "Contact us" link. Swap for a real inbox any
# time without a code change.
VITE_CONTACT_EMAIL=info@biopay.com

# Canonical public origin used by route metadata, robots.txt and sitemap.xml.
# Set this in the build environment when deploying under another domain.
VITE_PUBLIC_SITE_URL=https://biopay.app

# Optional. Set only when this date truthfully represents the last substantial
# public landing-page update; otherwise the sitemap correctly omits lastmod.
VITE_SITEMAP_LASTMOD=

# Optional separate inbox for demo requests; defaults to VITE_CONTACT_EMAIL.
VITE_DEMO_EMAIL=info@biopay.com
